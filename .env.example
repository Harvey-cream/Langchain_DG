# 唯一模板：仓库根目录 cp .env.example .env（勿提交 .env）
# 应用结构见 backend_langchain/env/settings_*.yaml，密钥通过 ${VAR} 从此文件注入
#
# 本地 uvicorn：APP_ENV=debug（MySQL localhost）；向量与线上一致走 DashScope（填 DASHSCOPE_API_KEY）
# 服务器 Docker：APP_ENV=production

APP_ENV=production

# 对话 LLM → settings_*.yaml llm.*
OPENAI_BASE_URL=https://gpt-agent.cc/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# 向量嵌入 → settings_*.yaml dashscope.*
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# 应用 → settings_*.yaml app.*
APP_SECRET_KEY=
APP_ALLOWED_HOST=38.190.206.248

# MySQL：Docker db 容器 + yaml mysql.password（两处密码保持一致）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=langchain
MYSQL_PUBLISH_PORT=3307
REDIS_PUBLISH_PORT=6379

# 本地 debug 连宿主机 MySQL 时可设（写入 settings_debug.yaml 的 ${MYSQL_HOST} 等）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# 可选
# SKIP_RAG_STARTUP_WARMUP=1
HF_ENDPOINT=https://hf-mirror.com
