# 可选：cp .env.example .env
# 启动前在 frontend_langchain 执行：npm ci && npm run build（dist 挂载给 nginx）
# backend 读 env/settings_pro.yaml；Nginx 使用 ./nginx/nginx.conf（80/443）

DJANGO_ENV=production

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=langchain
MYSQL_PUBLISH_PORT=3307
REDIS_PUBLISH_PORT=6379

# 本地嵌入模型从 HuggingFace 拉取；国内建议 hf-mirror，出访正常可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DOWNLOAD_TIMEOUT=600
