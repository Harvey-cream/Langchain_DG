# 可选：cp .env.example .env
# 启动前在 frontend_langchain 执行：npm ci && npm run build（dist 挂载给 nginx）
# backend 读 env/settings_pro.yaml；Nginx 使用 ./nginx/nginx.conf（80/443）

DJANGO_ENV=production

# 生产环境（DJANGO_ENV=production）向量嵌入：DashScope API。本地 HuggingFace 需：pip install -r requirements-dev.txt（及 CPU torch，见该文件）
DASHSCOPE_API_KEY=
# 百炼向量：v3/v4 用 OpenAI 兼容接口（见 common/embedding.py）；可选768/512 等
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=langchain
MYSQL_PUBLISH_PORT=3307
REDIS_PUBLISH_PORT=6379

# 本地嵌入模型从 HuggingFace 拉取；国内建议 hf-mirror，出访正常可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DOWNLOAD_TIMEOUT=600
