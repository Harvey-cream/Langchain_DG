# 唯一模板：仓库根目录 cp .env.example .env（勿提交 .env）
# 应用结构见 backend_langchain/env/settings_*.yaml，密钥通过 ${VAR} 从此文件注入
#
# 本地 uvicorn：APP_ENV=debug（PostgreSQL localhost）；向量与线上一致走 DashScope（填 DASHSCOPE_API_KEY）
# 服务器 Docker：APP_ENV=production

APP_ENV=production

# 对话 LLM（唯一 API 地址）→ settings_*.yaml llm.*
# 多模型顺序兜底：链 = 主模型 + 其余候选，按序兜底
LLM_AGENT_BASE_URL=https://api4.mygptlife.com/v1/
LLM_AGENT_API_KEY=
LLM_AGENT_MODEL=gemini-3.7-flash
LLM_AGENT_FALLBACK_MODELS=gpt-5.6-luna,claude-sonnet-4-6

# 向量嵌入 / 强制联网搜索（百炼 WebSearch）→ settings_*.yaml dashscope.*
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Contract 私有知识库：固定 1024 维，使用已有 DashScope Embedding / Rerank 配置
# Rerank 模型由 env/settings_*.yaml 的 dashscope.rerank_model 指定（默认 qwen3-rerank）
CONTRACT_RAG_TOP_K=3
CONTRACT_RAG_RECALL_K=24
CONTRACT_RAG_RERANK_COUNT=16
CONTRACT_RAG_TIMEOUT=30
# 每用户 Ready Chunk 上限；超出明确报错，不静默截断 BM25 语料
CONTRACT_RAG_BM25_MAX_CHUNKS=10000

# Contract Review Graph：每窗口最多 2 轮 / 4 个只读工具；不支持 Tool Calling 时明确报错
# false 是显式固定流程模式（仍保留基础 RAG / Structured Output / Quality Gate）
CONTRACT_REVIEW_REACT_ENABLED=true
CONTRACT_REVIEW_MAX_TOOL_ROUNDS=2
CONTRACT_REVIEW_MAX_TOOL_CALLS=4
CONTRACT_REVIEW_TOOL_TIMEOUT=30

# 应用 → settings_*.yaml app.*
APP_SECRET_KEY=
APP_ALLOWED_HOST=38.190.206.248

# PostgreSQL：Docker db 容器（pgvector）+ yaml postgres.password（保持一致）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=langchain
# LangGraph checkpoint 独立库（同实例；应用启动时 CREATE DATABASE IF NOT EXISTS）
POSTGRES_CHECKPOINT_DATABASE=langchain_checkpoint
POSTGRES_PUBLISH_PORT=5433
REDIS_PUBLISH_PORT=6379

# 本地 uvicorn + docker compose db（映射 5433）；本机原生 PG 则改 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# 阿里云 OSS（超级智能体侧栏文档上传；密钥勿提交）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=my-oss-bucket-2026-2026
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_PREFIX=agent-kb
OSS_URL_PREFIX=https://my-oss-bucket-2026-2026.oss-cn-shenzhen.aliyuncs.com

# 可选
# SKIP_RAG_STARTUP_WARMUP=1
HF_ENDPOINT=https://hf-mirror.com

# 短期记忆压缩（越小越快；默认 8 轮触发 / 保留 4 轮 / 16k token）
# MEMORY_MAX_TURNS=8
# MEMORY_KEEP_LAST_TURNS=4
# MEMORY_TOKEN_BUDGET=16000

# 长期 Memory Agent（异步；Trigger 规则过滤后再 Extract/Decision）
# MEMORY_AGENT_ENABLED=1
# MEMORY_TRIGGER_MIN_CHARS=16
# MEMORY_RETRIEVE_TOP_K=5
# MEMORY_RETRIEVE_MAX_CHARS=1200
