{
  "gitee": {
    "transport": "streamable_http",
    "url": "https://api.gitee.com/mcp",
    "headers": {
      "Authorization": "Bearer REPLACE_WITH_GITEE_TOKEN"
    }
  },
  "github": {
    "transport": "streamable_http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer REPLACE_WITH_GITHUB_TOKEN",
      "X-MCP-Toolsets": "repos",
      "X-MCP-Readonly": "true"
    }
  }
}
