# 复制为 .env 后按需修改（backend_langchain/.env 已 gitignore）

# 本地开发 + 阿里云向量 API（不装 torch）
DJANGO_ENV=production

# production yaml 里 mysql.host=db 仅适用于 Docker；本机连 compose 映射的 MySQL 必须覆盖：
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=langchain

# 百炼向量 / 对话 LLM（必填项请填入真实 Key）
DASHSCOPE_API_KEY=
# LLM_AGENT_BASE_URL=
# LLM_AGENT_API_KEY=
# LLM_AGENT_MODEL=

# 首次启动可跳过 RAG 预热
SKIP_RAG_STARTUP_WARMUP=1
